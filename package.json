{
  "name": "portloom",
  "version": "1.0.0",
  "description": "High-performance local developer gateway for Windows: port matrix, hosts profiles, 1-click trusted SSL, reverse proxy and webhook inspector",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "portloom": "./bin/portloom.js"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite src/client",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build src/client --outDir ../../dist/client",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "windows",
    "developer-tools",
    "port-manager",
    "hosts-manager",
    "local-ssl",
    "reverse-proxy",
    "webhook-inspector",
    "local-first",
    "dev-gateway"
  ],
  "author": "Portloom Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "node-forge": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
