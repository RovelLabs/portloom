# Portloom Configuration Environment Variables

# Management Web Dashboard & REST API Port (default: 24224)
PORTLOOM_PORT=24224

# Gateway HTTP Binding Port (default: 80)
PORTLOOM_HTTP_PORT=80

# Gateway HTTPS Binding Port (default: 443)
PORTLOOM_HTTPS_PORT=443

# Custom Data Directory (defaults to %APPDATA%\Portloom on Windows, ~/.config/portloom on Linux)
# APPDATA=C:\Users\username\AppData\Roaming

# Default UI Language (ru / en)
PORTLOOM_LANG=ru
